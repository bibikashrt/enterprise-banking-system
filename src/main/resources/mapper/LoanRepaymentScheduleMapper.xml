<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.bank.mapper.LoanRepaymentScheduleMapper">


    <resultMap id="loanRepaymentScheduleResultMap"
               type="com.bank.entity.LoanRepaymentSchedule">


        <id property="scheduleId"
            column="schedule_id"/>


        <result property="loanId"
                column="loan_id"/>


        <result property="installmentNumber"
                column="installment_number"/>


        <result property="dueDate"
                column="due_date"/>


        <result property="principalAmount"
                column="principal_amount"/>


        <result property="interestAmount"
                column="interest_amount"/>


        <result property="totalAmount"
                column="total_amount"/>


        <result property="scheduleStatus"
                column="schedule_status"/>


        <result property="createdAt"
                column="created_at"/>


        <result property="updatedAt"
                column="updated_at"/>


    </resultMap>



    <!-- Insert repayment schedule -->

    <insert id="insert"
            parameterType="com.bank.entity.LoanRepaymentSchedule"
            useGeneratedKeys="true"
            keyProperty="scheduleId">


        INSERT INTO loan_repayment_schedule
        (
        loan_id,
        installment_number,
        due_date,
        principal_amount,
        interest_amount,
        total_amount,
        schedule_status
        )

        VALUES
        (
        #{loanId},
        #{installmentNumber},
        #{dueDate},
        #{principalAmount},
        #{interestAmount},
        #{totalAmount},
        #{scheduleStatus}
        )


    </insert>



    <!-- Find all schedule by loan -->

    <select id="findByLoanId"
            resultMap="loanRepaymentScheduleResultMap">


        SELECT *
        FROM loan_repayment_schedule

        WHERE loan_id = #{loanId}

        ORDER BY installment_number ASC


    </select>



    <!-- Find next unpaid installment -->

    <select id="findNextPendingSchedule"
            resultMap="loanRepaymentScheduleResultMap">


        SELECT *

        FROM loan_repayment_schedule


        WHERE loan_id = #{loanId}

        AND schedule_status = 'PENDING'


        ORDER BY installment_number ASC


        LIMIT 1


    </select>

    <select id="findOverdueSchedules"
            resultMap="loanRepaymentScheduleResultMap">


        SELECT *

        FROM loan_repayment_schedule

        WHERE schedule_status = 'PENDING'

        AND due_date &lt; #{date}


    </select>




    <!-- Update schedule status -->

    <update id="updateStatus"
            parameterType="com.bank.entity.LoanRepaymentSchedule">


        UPDATE loan_repayment_schedule

        SET

        schedule_status = #{scheduleStatus},

        updated_at = CURRENT_TIMESTAMP


        WHERE schedule_id = #{scheduleId}


    </update>




    <!-- Update paid amount -->

    <update id="updatePaidAmount"
            parameterType="com.bank.entity.LoanRepaymentSchedule">


        UPDATE loan_repayment_schedule

        SET

        paid_amount = #{paidAmount},

        updated_at = CURRENT_TIMESTAMP


        WHERE schedule_id = #{scheduleId}


    </update>


</mapper>