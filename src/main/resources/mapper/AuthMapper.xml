<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.bank.mapper.AuthMapper">

    <resultMap id="EmployeeResultMap" type="com.bank.entity.Employee">

        <id property="employeeId" column="employee_id"/>

        <result property="employeeNumber" column="employee_number"/>
        <result property="branchId" column="branch_id"/>
        <result property="firstName" column="first_name"/>
        <result property="lastName" column="last_name"/>
        <result property="email" column="email"/>
        <result property="phoneNumber" column="phone_number"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="employeeRole" column="employee_role"/>
        <result property="employeeStatus" column="employee_status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>

    </resultMap>

    <select id="findByEmail"
            parameterType="string"
            resultMap="EmployeeResultMap">

        SELECT
        employee_id,
        employee_number,
        branch_id,
        first_name,
        last_name,
        email,
        phone_number,
        password_hash,
        employee_role,
        employee_status,
        created_at,
        updated_at
        FROM employee
        WHERE email = #{email}
        LIMIT 1

    </select>

</mapper>