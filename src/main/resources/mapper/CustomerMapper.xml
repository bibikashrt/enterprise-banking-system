<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.bank.mapper.CustomerMapper">

    <!-- ========================= -->
    <!-- Result Mapping            -->
    <!-- ========================= -->

    <resultMap id="customerResultMap"
               type="com.bank.entity.Customer">

        <id property="customerId" column="customer_id"/>

        <result property="customerNumber" column="customer_number"/>
        <result property="firstName" column="first_name"/>
        <result property="middleName" column="middle_name"/>
        <result property="lastName" column="last_name"/>
        <result property="dateOfBirth" column="date_of_birth"/>
        <result property="gender" column="gender"/>
        <result property="citizenshipNumber" column="citizenship_number"/>
        <result property="panNumber" column="pan_number"/>
        <result property="email" column="email"/>
        <result property="mobileNumber" column="mobile_number"/>
        <result property="address" column="address"/>
        <result property="customerStatus" column="customer_status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>

    </resultMap>


    <!-- ========================= -->
    <!-- Insert Customer           -->
    <!-- ========================= -->

    <insert id="insert"
            parameterType="com.bank.entity.Customer"
            useGeneratedKeys="true"
            keyProperty="customerId">

        INSERT INTO customer
        (
        customer_number,
        first_name,
        middle_name,
        last_name,
        date_of_birth,
        gender,
        citizenship_number,
        pan_number,
        email,
        mobile_number,
        address,
        customer_status
        )
        VALUES
        (
        #{customerNumber},
        #{firstName},
        #{middleName},
        #{lastName},
        #{dateOfBirth},
        #{gender},
        #{citizenshipNumber},
        #{panNumber},
        #{email},
        #{mobileNumber},
        #{address},
        #{customerStatus}
        )

    </insert>


    <!-- ========================= -->
    <!-- Find By ID                -->
    <!-- ========================= -->

    <select id="findById"
            resultMap="customerResultMap">

        SELECT *
        FROM customer
        WHERE customer_id = #{customerId}

    </select>


    <!-- ========================= -->
    <!-- Find By Customer Number   -->
    <!-- ========================= -->

    <select id="findByCustomerNumber"
            resultMap="customerResultMap">

        SELECT *
        FROM customer
        WHERE customer_number = #{customerNumber}

    </select>


    <!-- ========================= -->
    <!-- Find By Citizenship       -->
    <!-- ========================= -->

    <select id="findByCitizenshipNumber"
            resultMap="customerResultMap">

        SELECT *
        FROM customer
        WHERE citizenship_number = #{citizenshipNumber}

    </select>


    <!-- ========================= -->
    <!-- Find By PAN               -->
    <!-- ========================= -->

    <select id="findByPanNumber"
            resultMap="customerResultMap">

        SELECT *
        FROM customer
        WHERE pan_number = #{panNumber}

    </select>


    <!-- ========================= -->
    <!-- Find By Email             -->
    <!-- ========================= -->

    <select id="findByEmail"
            resultMap="customerResultMap">

        SELECT *
        FROM customer
        WHERE email = #{email}

    </select>


    <!-- ========================= -->
    <!-- Find All Active Customers -->
    <!-- ========================= -->

    <select id="findAll"
            resultMap="customerResultMap">

        SELECT *
        FROM customer
        WHERE customer_status != 'CLOSED'
        ORDER BY customer_id DESC

    </select>


    <!-- ========================= -->
    <!-- Search Customer           -->
    <!-- ========================= -->

    <select id="search"
            resultMap="customerResultMap">

        SELECT *
        FROM customer

        WHERE customer_status != 'CLOSED'
        AND (
        LOWER(first_name) LIKE LOWER(CONCAT('%', #{keyword}, '%'))
        OR LOWER(last_name) LIKE LOWER(CONCAT('%', #{keyword}, '%'))
        OR LOWER(customer_number) LIKE LOWER(CONCAT('%', #{keyword}, '%'))
        )

        ORDER BY customer_id DESC

    </select>


    <!-- ========================= -->
    <!-- Update Customer           -->
    <!-- ========================= -->

    <update id="update"
            parameterType="com.bank.entity.Customer">

        UPDATE customer
        SET

        first_name = #{firstName},
        middle_name = #{middleName},
        last_name = #{lastName},
        date_of_birth = #{dateOfBirth},
        gender = #{gender},
        citizenship_number = #{citizenshipNumber},
        pan_number = #{panNumber},
        email = #{email},
        mobile_number = #{mobileNumber},
        address = #{address},
        customer_status = #{customerStatus},
        updated_at = CURRENT_TIMESTAMP

        WHERE customer_id = #{customerId}

    </update>


    <!-- ========================= -->
    <!-- Close Customer            -->
    <!-- ========================= -->

    <update id="closeCustomer">

        UPDATE customer
        SET
        customer_status = 'CLOSED',
        updated_at = CURRENT_TIMESTAMP

        WHERE customer_id = #{customerId}

    </update>

</mapper>