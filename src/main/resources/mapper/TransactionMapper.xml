<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.bank.mapper.TransactionMapper">

    <resultMap id="transactionResultMap"
               type="com.bank.entity.Transaction">

        <id property="transactionId" column="transaction_id"/>

        <result property="transactionReference" column="transaction_reference"/>
        <result property="accountId" column="account_id"/>
        <result property="counterpartyAccountId" column="counterparty_account_id"/>
        <result property="transactionType" column="transaction_type"/>
        <result property="amount" column="amount"/>
        <result property="balanceAfter" column="balance_after"/>
        <result property="description" column="description"/>
        <result property="transactionStatus" column="transaction_status"/>
        <result property="transactionTime" column="transaction_time"/>

    </resultMap>

    <!-- ========================= -->
    <!-- Insert Transaction        -->
    <!-- ========================= -->

    <insert id="insert"
            parameterType="com.bank.entity.Transaction"
            useGeneratedKeys="true"
            keyProperty="transactionId">

        INSERT INTO transaction
        (
        transaction_reference,
        account_id,
        counterparty_account_id,
        transaction_type,
        amount,
        balance_after,
        description,
        transaction_status
        )
        VALUES
        (
        #{transactionReference},
        #{accountId},
        #{counterpartyAccountId},
        #{transactionType},
        #{amount},
        #{balanceAfter},
        #{description},
        #{transactionStatus}
        )

    </insert>

    <!-- ========================= -->
    <!-- Find By ID                -->
    <!-- ========================= -->

    <select id="findById"
            resultMap="transactionResultMap">

        SELECT *
        FROM transaction
        WHERE transaction_id = #{transactionId}

    </select>

    <!-- ========================= -->
    <!-- Find By Reference         -->
    <!-- ========================= -->

    <select id="findByReference"
            resultMap="transactionResultMap">

        SELECT *
        FROM transaction
        WHERE transaction_reference = #{transactionReference}

    </select>

    <!-- ========================= -->
    <!-- Find By Account           -->
    <!-- ========================= -->

    <select id="findByAccountId"
            resultMap="transactionResultMap">

        SELECT *
        FROM transaction
        WHERE account_id = #{accountId}
        ORDER BY transaction_time DESC

    </select>

    <!-- ========================= -->
    <!-- Find All                  -->
    <!-- ========================= -->

    <select id="findAll"
            resultMap="transactionResultMap">

        SELECT *
        FROM transaction
        ORDER BY transaction_time DESC

    </select>

</mapper>